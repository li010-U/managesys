# ============================================
#  数据中心资源智能管理系统 - 环境配置模板
#  复制为 backend/.env 并修改配置
# ============================================

# --- 数据库 ---
# 开发环境（SQLite，默认）：
#   DATABASE_URL=sqlite+aiosqlite:///./data/managesys.db
#
# 生产环境（PostgreSQL，多人同时在线建议）：
#   1) 先创建数据库（表结构会在启动/初始化时自动创建），例如：
#      CREATE DATABASE managesys;
#   2) 设置连接串（请替换 user/pass/host/port/dbname）：
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/managesys
#
# 说明：启动脚本 start_prod.bat 检测到 postgres/postgresql 会自动切到多 worker(2)。
#       初始化命令：cd backend && python manage.py init

# --- JWT 安全（【必改】） ---
# 请使用足够长度的随机密钥，例如在 PowerShell 生成：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# 生产环境务必修改，切勿使用默认值，否则攻击者可用它伪造任意用户登录。
# 警告：不得使用默认值占位，否则启动时被配置校验拒绝。请生成并填入强随机密钥，例如：$Env:SECRET_KEY=$(python -c "import secrets;print(secrets.token_urlsafe(64))")
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# 令牌有效期建议：普通模式 60-1440 分钟；高安全场景 30-60 分钟。

# --- 初始管理员密码（【生产必改】） ---
# 首次初始化时创建的默认 super_admin 初始密码。生产必须设为强随机值，
# 例如：INIT_ADMIN_PASSWORD=$(python -c "import secrets; print(secrets.token_urlsafe(16))")
# 该账号登录后会被强制要求修改密码。
INIT_ADMIN_PASSWORD=$(python -c "import secrets; print(secrets.token_urlsafe(16))")

# --- 允许的 Host 头（防 Host 头投毒） ---
# 逗号分隔；生产以实际访问域名/公网 IP 为准，例如：ALLOWED_HOSTS=dcimanage.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,test

# --- 可信任反向代理网段（防客户端伪造 IP） ---
# 逗号分隔的 CIDR/网段；仅当 TCP 直连对端在这些网段时才信任 X-Forwarded-For / X-Real-IP。
# 为空（默认）表示不信任任何代理头、一律使用直连 IP。
# 若后端部署在 Nginx 等反向代理之后，请填代理所在内网网段，例如：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# 若后端直接对公网/内网暴露（无可信代理），保持空即可，天然防 X-Forwarded-For 伪造绕过限流。
TRUSTED_PROXIES=

# --- 调试模式 ---
# 生产环境必须设为 false（DEBUG=true 会回显完整 SQL、暴露更详细错误）。
DEBUG=false

# --- 验证码 ---
# 生产公网环境建议开启，配合登录失败锁账号抵御暴力破解。
# 说明：系统已实现登录失败次数锁账号（LOGIN_MAX_ATTEMPTS=5、锁定30分钟）。
#       未做 IP 级/接口级限流，公网暴露时建议在网关层(WAF/Nginx)额外限流。
ENABLE_CAPTCHA=true
# --- 验证码共享存储（多 worker 部署彻底消除误报） ---
# 单 worker / 未配置 REDIS_URL 时，验证码默认走进程内内存存储（零性能影响）。
# 多 worker / 多副本必须让验证码跨进程共享，否则会出现“验证码正确却提示错误”。
# 配置 REDIS_URL 后验证码写入 Redis 并原子一次性消费（GETDEL），彻底消除该问题；
# Redis 短暂不可用时自动回退内存存储（fail-open），不会锁死登录。
# 该 REDIS_URL 与集中式限流可复用同一个 Redis 实例。
#REDIS_URL=redis://127.0.0.1:6379/0
# 验证码有效期（秒），默认 300（5 分钟）
#CAPTCHA_TTL_SECONDS=300
# 验证码 Redis 键前缀
#CAPTCHA_REDIS_PREFIX=captcha:
ENABLE_CAPTCHA=true

# --- 生产安全准入（fail-closed） ---
# 生产环境建议设为 true：启动时若检测到不可妥协项（DEBUG=true 或默认 SECRET_KEY）
# 将直接拒绝启动（raise），而不是仅打警告，避免带病上线。
# 开发环境保持 false（维持警告模式）。
ENFORCE_SECURITY=true

# --- 端口限流（防止暴力碰库 / 注册垃圾账号） ---
# 每个 IP 在窗口内允许的登录、注册次数与窗口长度（秒）
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- 密码策略 ---
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# --- 文件上传 ---
# 上传目录已防路径穿越，警告：文件上传/下载/删除都会校验最终路径落在此目录内。
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=104857600

# --- 数据库连接池 / 查询超时（SQLite 与 PostgreSQL 均适用） ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600
# 连接池等待空闲连接的超时（秒）：池满时等待超过此时间即迅速报错，防止无限排队。
DB_POOL_TIMEOUT=10
# 单条 SQL 执行超时（秒）：避免查询悬置拖死请求。
DB_QUERY_TIMEOUT=30

# --- 并发控制（防止“点快了加载不出来”与多人同时在线资源恜死） ---
# 全局同时处理的 HTTP 请求上限；超出后新请求在短时间内等待空位，超时返回 503。
HTTP_MAX_CONCURRENCY=200
# 同进程内并发的 SSE 长连接上限；超出后新 SSE 请求返回 503。
SSE_MAX_CONNECTIONS=30

# --- AI 聊天限流（每个用户在窗口内允许的聊天/LLM 请求次数，防资源/成本滥用） ---
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- 邮件服务（可选） ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM_NAME=DCIManage 系统
#SMTP_ENABLED=false


# ============================================
#  AI / LLM 配置（支持多 provider 切换）
# ============================================
# LLM_PROVIDER 取值：
#   1) deepseek  - DeepSeek 官方 API
#   2) openai    - OpenAI 同步接口
#   3) internal  - 内网 OpenAI 兼容网关
LLM_PROVIDER=deepseek

# --- DeepSeek (LLM_PROVIDER=deepseek) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 每个 provider 可独立指定模型，切换 provider 时模型自动联动。
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 内网 OpenAI 兼容网关 (LLM_PROVIDER=internal) ---
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_KEY=
INTERNAL_MODEL=deepseek-chat

# --- LLM 调用超时（可配置） ---
LLM_TIMEOUT_SECONDS=60
# --- 传感数据保留（默认 180 天，进程内每日定时清理） ---
# 传感器时序数据最低保留天数；到期后由进程内每日任务滚动清理 sensor_data 与异常留痕表。
DATA_RETENTION_DAYS=180
# 到期清理余量（天），避免时区/边界误删刚满保留期的记录。
DATA_RETENTION_BUFFER_DAYS=3
# 传感器期望采集间隔（秒），用于判定"两采集点之间越阈"的留痕窗口。
SENSOR_EXPECTED_INTERVAL_SECONDS=3600
# 采集间隔容差倍数：超过 期望间隔 x 容差 即认为落在非采集点窗口。
SENSOR_GAP_TOLERANCE=1.5
# 是否启用进程内每日保留清理任务（启动即跑一次 + 每日一次）。
DATA_RETENTION_TASK_ENABLED=true

# ===== 告警生命周期 =====
ALERT_AUTO_RESOLVE_MINUTES=30
ALERT_TRANSIENT_MAX_SECONDS=300
ALERT_COOLDOWN_MINUTES=5
ALERT_LIFECYCLE_TASK_ENABLED=true
ALERT_LIFECYCLE_INTERVAL_SECONDS=60

# ===== 环境/气象自动轮询采集 =====
# 默认关闭；开启后按 interval 定期写入 env_weather_records 供关联统计
ENV_POLL_TASK_ENABLED=false
ENV_POLL_INTERVAL_SECONDS=300
ENV_POLL_SOURCE=sim
# real 源定位（默认合肥）
ENV_POLL_LAT=31.82
ENV_POLL_LON=117.23
ENV_POLL_LOCATION_NAME=主机房
ENV_POLL_LOCATION_ID=0
