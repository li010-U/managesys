# ============================================
#  数据中心资源智能管理系统 - 环境配置模板
#  复制为 backend/.env 并修改配置
# ============================================

# --- 数据库 ---
# 开发环境（SQLite，默认）：
#   DATABASE_URL=sqlite+aiosqlite:///./data/managesys.db
#
# 生产环境（PostgreSQL，多人同时在线建议）：
#   1) 先创建数据库（表结构会在启动/初始化时自动创建），例如：
#      CREATE DATABASE managesys;
#   2) 设置连接串（请替换 user/pass/host/port/dbname）：
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/managesys
#
# 说明：启动脚本 start_prod.bat 检测到 postgres/postgresql 会自动切到多 worker(2)。
#       初始化命令：cd backend && python manage.py init

# --- JWT 安全（【必改】） ---
# 请使用足够长度的随机密钥，例如在 PowerShell 生成：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# 生产环境务必修改，切勿使用默认值，否则攻击者可用它伪造任意用户登录。
SECRET_KEY=dev-secret-key-change-in-production-2024
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 令牌有效期建议：普通模式 60-1440 分钟；高安全场景 30-60 分钟。

# --- 初始管理员密码（【生产必改】） ---
# 首次初始化时创建的默认 super_admin 初始密码。生产必须设为强随机值，
# 例如：INIT_ADMIN_PASSWORD=$(python -c "import secrets; print(secrets.token_urlsafe(16))")
# 该账号登录后会被强制要求修改密码。
INIT_ADMIN_PASSWORD=admin@123456

# --- 允许的 Host 头（防 Host 头投毒） ---
# 逗号分隔；生产以实际访问域名/公网 IP 为准，例如：ALLOWED_HOSTS=dcimanage.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,test

# --- 调试模式 ---
# 生产环境必须设为 false（DEBUG=true 会回显完整 SQL、暴露更详细错误）。
DEBUG=false

# --- 验证码 ---
# 生产公网环境建议开启，配合登录失败锁账号抵御暴力破解。
# 说明：系统已实现登录失败次数锁账号（LOGIN_MAX_ATTEMPTS=5、锁定30分钟）。
#       未做 IP 级/接口级限流，公网暴露时建议在网关层(WAF/Nginx)额外限流。
ENABLE_CAPTCHA=false

# --- 端口限流（防止暴力碰库 / 注册垃圾账号） ---
# 每个 IP 在窗口内允许的登录、注册次数与窗口长度（秒）
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- 密码策略 ---
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# --- 文件上传 ---
# 上传目录已防路径穿越，警告：文件上传/下载/删除都会校验最终路径落在此目录内。
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=104857600

# --- 数据库连接池 / 查询超时（SQLite 与 PostgreSQL 均适用） ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600
# 连接池等待空闲连接的超时（秒）：池满时等待超过此时间即迅速报错，防止无限排队。
DB_POOL_TIMEOUT=10
# 单条 SQL 执行超时（秒）：避免查询悬置拖死请求。
DB_QUERY_TIMEOUT=30

# --- 并发控制（防止“点快了加载不出来”与多人同时在线资源恜死） ---
# 全局同时处理的 HTTP 请求上限；超出后新请求在短时间内等待空位，超时返回 503。
HTTP_MAX_CONCURRENCY=200
# 同进程内并发的 SSE 长连接上限；超出后新 SSE 请求返回 503。
SSE_MAX_CONNECTIONS=30

# --- AI 聊天限流（每个用户在窗口内允许的聊天/LLM 请求次数，防资源/成本滥用） ---
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- 邮件服务（可选） ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM_NAME=DCIManage 系统
#SMTP_ENABLED=false


